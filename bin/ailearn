#!/usr/bin/env bash
# MyProfessor launcher.
#
# Put it on PATH once:
#   ln -s "$PWD/bin/ailearn" /usr/local/bin/ailearn
#
# Then `ailearn` from anywhere. The jar is rebuilt only when something under
# src/ or pom.xml is newer than it, so a normal start costs a JVM and nothing else.
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_DIR"

# Read the version from the pom so the jar name never has to be kept in step here.
VERSION="$(awk '/<artifactId>myprofessor<\/artifactId>/{f=1} f&&/<version>/{gsub(/.*<version>|<\/version>.*/,""); print; exit}' pom.xml)"
JAR="target/myprofessor-${VERSION}.jar"

if [[ ! -f "$JAR" ]] || [[ -n "$(find src pom.xml -newer "$JAR" 2>/dev/null | head -n 1)" ]]; then
  printf 'Building MyProfessor %s...\n' "$VERSION"
  ./mvnw -q -DskipTests package
fi

# The cli profile swaps the HTTP server for the shell.
exec java -jar "$JAR" --spring.profiles.active=cli "$@"
